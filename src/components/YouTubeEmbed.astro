---
// Lightweight YouTube embed (via lite-youtube-embed), rendering the poster
// as a real <img> instead of an inline background-image style, since
// inline styles are blocked by the site's Content-Security-Policy.
import "lite-youtube-embed/src/lite-yt-embed.css";

export interface Props {
	id: string;
	title?: string;
	playlabel?: string;
}

const { id, title, playlabel = "Play" } = Astro.props;

const urlPattern =
	/(?:https?:\/\/)?(?:w{3}\.)?(?:youtube\.com|youtu\.be)\/(?:watch\?v=|embed\/|shorts\/)?([A-Za-z0-9-_]{11})/;

const videoid = urlPattern.exec(id)?.[1] ?? id;
const posterURL = `https://i.ytimg.com/vi/${videoid}/hqdefault.jpg`;
---

<lite-youtube videoid={videoid} title={title} data-title={title}>
	<img class="lyt-poster" src={posterURL} alt="" loading="lazy" />
	<a href={`https://youtube.com/watch?v=${videoid}`} class="lyt-playbtn">
		<span class="lyt-visually-hidden">{playlabel}</span>
	</a>
</lite-youtube>

<script src="lite-youtube-embed"></script>

<style>
	lite-youtube {
		position: relative;
	}

	lite-youtube > .lyt-poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	lite-youtube > iframe {
		all: unset !important;
		width: 100% !important;
		height: 100% !important;
		position: absolute !important;
		inset: 0 !important;
		border: 0 !important;
	}
</style>
