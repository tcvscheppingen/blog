---
import GithubIcon from "../assets/icons/github.svg";
import RssIcon from "../assets/icons/rss.svg";
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Thymen van Scheppingen <br />
	<a href="/privacy-policy">Privacy Policy</a> - <a
		href="https://github.com/tcvscheppingen"
		class="icon-link"
		><GithubIcon width={16} height={16} aria-hidden="true" /> GitHub</a
	> - <a href="/rss.xml" class="icon-link"
		><RssIcon width={16} height={16} aria-hidden="true" /> RSS</a
	>
</footer>

<style>
	/* A strip in the colors of the dwm bar */
	footer {
		padding: 0.8em var(--gap-x);
		background: var(--bar-bg);
		border-top: 1px solid var(--bar-line);
		color: rgb(var(--gray));
		font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
		font-size: 14px;
		line-height: 1.7;
		text-align: center;
	}
	.icon-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		vertical-align: middle;
	}
</style>
