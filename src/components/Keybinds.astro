---
// The site's keybinds, and the windows that open next to the page: one that
// lists the keybinds (? or the "?" button in the bar) and fastfetch (f, in
// Fastfetch.astro). Like new windows in dwm with attachaside, they go on top
// of the stack and tile next to the page (the layout rules for that are in
// global.css). Open windows stay open on the next page, until you close them.
import Fastfetch from "./Fastfetch.astro";

const binds = [
	{
		section: "SEARCH",
		keys: [
			{ keys: ["d"], action: "open the search (dmenu)" },
			{
				keys: ["↑", "↓"],
				action: "select a result (also ctrl+n, ctrl+p)",
			},
			{ keys: ["enter"], action: "open the selected result" },
			{ keys: ["esc"], action: "close the search" },
		],
	},
	{
		section: "SCROLL",
		keys: [
			{ keys: ["j", "k"], action: "scroll down, up" },
			{ keys: ["gg", "G"], action: "jump to the top, bottom" },
		],
	},
	{
		section: "POSTS",
		keys: [
			{
				keys: ["j", "k"],
				action: "focus the next, previous article (like newsboat)",
			},
			{ keys: ["↓", "↑"], action: "the same as j and k" },
			{ keys: ["gg", "G"], action: "focus the first, last article" },
			{ keys: ["enter"], action: "open the focused article" },
			{ keys: ["/"], action: "search the articles" },
			{ keys: ["q"], action: "in a post: go back to the posts" },
		],
	},
	{
		section: "WINDOWS",
		keys: [
			{
				keys: ["t"],
				action: "next layout: tile, monocle, centered master, floating",
			},
			{ keys: ["s"], action: "show the keys you press (like screenkey)" },
			{ keys: ["?"], action: "show or hide this window" },
			{ keys: ["f"], action: "show or hide fastfetch" },
			{ keys: ["q", "esc"], action: "close the focused window" },
			{ keys: ["h", "l"], action: "focus the page, the next window" },
			{
				keys: ["click"],
				action: "focus a window; j and k scroll the focused one",
			},
		],
	},
];
---

<div id="stack-area">
	<div id="stack" hidden>
		<section
			id="keybinds"
			class="keybinds"
			aria-labelledby="keybinds-title"
			tabindex="-1"
			hidden
		>
			<p class="prompt" aria-hidden="true">
				<span class="user">[thymen@thymen.dev ~]</span><span
					class="sign">$</span
				> man keybinds
			</p>
			<div class="man">
				<p class="man-header" aria-hidden="true">
					<span>KEYBINDS(7)</span><span>thymen.dev</span><span
						>KEYBINDS(7)</span
					>
				</p>
				<h2 id="keybinds-title">NAME</h2>
				<p class="indent">
					keybinds - move around this site without a mouse
				</p>
				{
					binds.map(({ section, keys }) => (
						<>
							<h2>{section}</h2>
							<dl class="indent">
								{keys.map(({ keys, action }) => (
									<>
										<dt>
											{keys.map((key) => (
												<kbd>{key}</kbd>
											))}
										</dt>
										<dd>{action}</dd>
									</>
								))}
							</dl>
						</>
					))
				}
				<p class="note indent">
					The keys don't work while typing in a text field.
				</p>
			</div>
			<!-- The prompt of less, which man pages open in; it closes the window -->
			<button type="button" class="pager" data-close>
				Manual page keybinds(7) line 1 (press q to quit)
			</button>
		</section>
		<Fastfetch />
	</div>
</div>

<!-- screenkey: the keys you press, at the bottom of the screen. Toggled with s -->
<div id="screenkey" class="screenkey" aria-hidden="true" hidden></div>

<style>
	.screenkey {
		position: fixed;
		bottom: 24px;
		left: 50%;
		z-index: 30;
		max-width: calc(100vw - 40px);
		padding: 6px 18px;
		box-sizing: border-box;
		transform: translateX(-50%);
		background: var(--bar-bg);
		border: var(--term-border) solid var(--accent-line);
		color: rgb(var(--black));
		font-family:
			ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
			monospace;
		font-size: 22px;
		font-weight: 700;
		white-space: pre;
		overflow: hidden;
		pointer-events: none;
	}
	.screenkey[hidden] {
		display: none;
	}
	.keybinds {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		background: var(--term-bg);
		border: var(--term-border) solid var(--accent-line);
		color: rgb(var(--gray-dark));
		font-family:
			ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
			monospace;
		font-size: 15px;
		line-height: 1.5;
		outline: none;
		overflow-y: auto;
	}
	.keybinds[hidden] {
		display: none;
	}
	.prompt {
		margin: 0;
		padding: 1em 1.4em 0;
		overflow-wrap: anywhere;
	}
	.user {
		color: var(--green);
	}
	.sign {
		color: var(--accent);
	}
	.man {
		flex: 1;
		padding: 1em 1.4em;
	}
	.man-header {
		display: flex;
		/* Wraps in the narrow side window of |M| */
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1em;
		margin: 0 0 1em;
		color: rgb(var(--gray));
	}
	h2 {
		margin: 1em 0 0.3em;
		color: rgb(var(--black));
		font-size: 1em;
		font-weight: 700;
	}
	.indent {
		margin: 0 0 0 3ch;
	}
	dl {
		display: grid;
		/* The same key column in every section, like a man page */
		grid-template-columns: 8ch 1fr;
		gap: 0.25em 2ch;
	}
	dt {
		display: flex;
		gap: 0.6ch;
	}
	dd {
		margin: 0;
	}
	kbd {
		color: var(--cyan);
		font-family: inherit;
	}
	.note {
		margin-top: 1.5em;
		color: rgb(var(--gray));
	}
	.pager {
		position: sticky;
		bottom: 0;
		padding: 0.1em 1.4em;
		border: none;
		background: rgb(var(--gray-dark));
		color: var(--bg);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	.pager:hover,
	.pager:focus-visible {
		background: var(--sel-bg);
		color: var(--sel-fg);
		outline: none;
	}
</style>

<script>
	const root = document.documentElement;
	const stack = document.getElementById("stack") as HTMLDivElement;
	const windows = [
		...stack.querySelectorAll<HTMLElement>(":scope > section"),
	];
	const main = document.querySelector("main");

	// The stack lives next to the page so it can tile with it
	main?.after(document.getElementById("stack-area") as HTMLDivElement);

	// The open windows, the newest on top of the stack, and the focused window.
	// Kept in session storage (see the privacy policy), so they stay open on
	// the next page; public/layout.js reads it too, so the page doesn't jump
	let open: string[] = [];
	let focused = "master";
	try {
		const saved = JSON.parse(sessionStorage.getItem("windows") ?? "{}");
		if (Array.isArray(saved.open)) {
			open = saved.open.filter((id: unknown) =>
				windows.some((win) => win.id === id),
			);
		}
		if (open.includes(saved.focused)) focused = saved.focused;
	} catch {}

	function render() {
		windows.forEach((win) => {
			win.hidden = !open.includes(win.id);
			// Its place in the stack, from the top: the order in tile, and the
			// side in |M| (global.css)
			win.style.order = String(open.indexOf(win.id));
			win.dataset.slot = String(open.indexOf(win.id));
			// Like dwm: the focused window has the blue border
			win.classList.toggle("focused", win.id === focused);
		});
		stack.hidden = open.length === 0;
		if (open.length > 0) {
			root.dataset.stack = String(open.length);
			root.dataset.focus = focused === "master" ? "master" : "stack";
		} else {
			delete root.dataset.stack;
			delete root.dataset.focus;
		}
		try {
			if (open.length > 0)
				sessionStorage.setItem(
					"windows",
					JSON.stringify({ open, focused }),
				);
			else sessionStorage.removeItem("windows");
		} catch {}
	}

	// The focused window also gets the browser's focus, so the arrow keys,
	// space and page down scroll it. Clicking in a window does that by itself
	if (main) main.tabIndex = -1;
	function focusElement() {
		const win =
			focused === "master" ? main : document.getElementById(focused);
		if (win && !win.contains(document.activeElement))
			win.focus({ preventScroll: true });
	}

	function focus(id: string) {
		focused = id;
		render();
		focusElement();
	}

	function openWindow(id: string) {
		open = [id, ...open.filter((other) => other !== id)];
		focus(id);
		document.getElementById(id)?.scrollTo({ top: 0 });
	}

	function closeWindow(id: string) {
		open = open.filter((other) => other !== id);
		// The focus goes to the window on top of the stack, or the page
		if (focused === id || open.length === 0) focused = open[0] ?? "master";
		render();
		focusElement();
	}

	function toggleWindow(id: string) {
		if (open.includes(id)) closeWindow(id);
		else openWindow(id);
	}

	// l focuses the stack, and then the next window in it
	function focusNext() {
		const next = focused === "master" ? 0 : open.indexOf(focused) + 1;
		focus(open[next % open.length]);
	}

	render();
	if (document.activeElement === document.body) focusElement();

	// On a desktop the page window scrolls rather than the page (global.css),
	// and browsers only remember where you were on the page. So the page
	// window keeps that in its history entry, for back and forward
	if (main) {
		const saved = history.state?.mainScroll;
		if (typeof saved === "number") main.scrollTop = saved;
		let saveTimer: ReturnType<typeof setTimeout> | undefined;
		main.addEventListener("scroll", () => {
			clearTimeout(saveTimer);
			saveTimer = setTimeout(
				() =>
					history.replaceState(
						{ ...history.state, mainScroll: main.scrollTop },
						"",
					),
				200,
			);
		});
	}

	document
		.getElementById("keybinds-toggle")
		?.addEventListener("click", () => toggleWindow("keybinds"));
	main?.addEventListener(
		"pointerdown",
		() => open.length > 0 && focus("master"),
	);
	windows.forEach((win) => {
		win.addEventListener(
			"pointerdown",
			() => focused !== win.id && focus(win.id),
		);
		win.querySelector("[data-close]")?.addEventListener("click", () =>
			closeWindow(win.id),
		);
	});

	// j and k scroll the focused window when it scrolls by itself (on a
	// desktop all windows do), otherwise the page
	function scroller(): {
		scrollBy(options: ScrollToOptions): void;
		scrollHeight: number;
		clientHeight: number;
	} {
		const win =
			focused === "master" ? main : document.getElementById(focused);
		if (win && getComputedStyle(win).overflowY !== "visible") return win;
		return {
			scrollBy: (options) => window.scrollBy(options),
			scrollHeight: document.documentElement.scrollHeight,
			clientHeight: window.innerHeight,
		};
	}

	function isTyping(target: EventTarget | null) {
		return (
			target instanceof HTMLElement &&
			(target.isContentEditable ||
				/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))
		);
	}

	// No smooth scrolling: in dwm things just move
	const step = 120;
	const behavior: ScrollBehavior = "instant";
	let lastG = 0;
	// Phones and tablets: the keys are off, there's no keyboard to use them
	// with. Narrow windows on a computer keep them, like a browser tiled to
	// half the screen
	const touch = window.matchMedia("(hover: none) and (pointer: coarse)");

	document.addEventListener("keydown", (event) => {
		if (touch.matches) return;
		// Already handled by the page itself, like j and k on the posts page
		if (event.defaultPrevented) return;
		if (event.ctrlKey || event.metaKey || event.altKey) return;
		if (isTyping(event.target) || document.querySelector("dialog[open]"))
			return;

		const target = scroller();
		switch (event.key) {
			case "j":
				target.scrollBy({ top: step, behavior });
				break;
			case "k":
				target.scrollBy({ top: -step, behavior });
				break;
			case "d":
				// The search is in Dmenu.astro; its button in the bar opens it
				document.getElementById("dmenu-open")?.click();
				break;
			case "G":
				target.scrollBy({ top: target.scrollHeight, behavior });
				break;
			case "g":
				// gg: two g's in a row
				if (event.timeStamp - lastG < 500) {
					target.scrollBy({ top: -target.scrollHeight, behavior });
					lastG = 0;
				} else {
					lastG = event.timeStamp;
				}
				break;
			case "s":
				toggleScreenkey();
				break;
			case "t":
				// The layouts live in NavBar.astro; its []= button cycles them
				document.getElementById("layout-toggle")?.click();
				break;
			case "h":
				if (open.length === 0) return;
				focus("master");
				break;
			case "l":
				if (open.length === 0) return;
				focusNext();
				break;
			case "?":
				toggleWindow("keybinds");
				break;
			case "f":
				toggleWindow("fastfetch");
				break;
			case "q":
				// q closes a window first (the focused one, or the top of the
				// stack); in a post it quits to the posts
				if (open.length > 0)
					closeWindow(focused === "master" ? open[0] : focused);
				else if (/^\/blog\/./.test(window.location.pathname))
					window.location.href = "/blog";
				else return;
				break;
			case "Escape":
				if (open.length === 0) return;
				closeWindow(focused === "master" ? open[0] : focused);
				break;
			default:
				return;
		}
		event.preventDefault();
	});

	// screenkey. On or off is kept in local storage (see the privacy policy),
	// so it stays on while following links
	const screenkey = document.getElementById("screenkey") as HTMLDivElement;
	const keyNames: Record<string, string> = {
		Enter: "⏎",
		Escape: "esc",
		ArrowDown: "↓",
		ArrowUp: "↑",
		ArrowLeft: "←",
		ArrowRight: "→",
		Backspace: "⌫",
		Tab: "tab",
		" ": "␣",
	};
	let screenkeyOn = false;
	let lastKey = 0;
	let screenkeyTimer: ReturnType<typeof setTimeout> | undefined;

	function showKeys(text: string, append: boolean) {
		const keys = append
			? `${screenkey.textContent} ${text}`.split(" ").slice(-8).join(" ")
			: text;
		screenkey.textContent = keys;
		screenkey.hidden = false;
		clearTimeout(screenkeyTimer);
		screenkeyTimer = setTimeout(() => (screenkey.hidden = true), 1500);
	}

	function setScreenkey(on: boolean) {
		screenkeyOn = on;
		try {
			if (on) localStorage.setItem("screenkey", "on");
			else localStorage.removeItem("screenkey");
		} catch {}
	}

	function toggleScreenkey() {
		setScreenkey(!screenkeyOn);
		showKeys(screenkeyOn ? "screenkey on" : "screenkey off", false);
	}

	try {
		screenkeyOn = localStorage.getItem("screenkey") === "on";
	} catch {}

	// In the capture phase, so it also sees keys the page or the search handle
	window.addEventListener(
		"keydown",
		(event) => {
			if (
				!screenkeyOn ||
				touch.matches ||
				["Shift", "Control", "Meta", "Alt"].includes(event.key)
			)
				return;
			// The toggle shows its own message
			if (
				event.key === "s" &&
				!isTyping(event.target) &&
				!document.querySelector("dialog[open]")
			)
				return;
			const modifiers = [
				event.ctrlKey && "ctrl",
				event.metaKey && "cmd",
				event.altKey && "alt",
			].filter(Boolean);
			const key = keyNames[event.key] ?? event.key;
			// Keys pressed shortly after each other are shown together
			showKeys(
				[...modifiers, key].join("+"),
				event.timeStamp - lastKey < 700,
			);
			lastKey = event.timeStamp;
		},
		{ capture: true },
	);
</script>
