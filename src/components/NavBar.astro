---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav role="navigation">
		<h2><a href="/" class="site-title">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Posts</HeaderLink>
			<HeaderLink href="/books">Books</HeaderLink>
			<HeaderLink href="/websites">Links</HeaderLink>
			<HeaderLink href="/uses">Uses</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<label id="menuToggle" for="menu-checkbox" aria-label="Toggle menu">
			<input id="menu-checkbox" type="checkbox" />
			<span></span>
			<span></span>
			<span></span>
		</label>
		<ul id="menu">
			<li><HeaderLink href="/">Home</HeaderLink></li>
			<li><HeaderLink href="/blog">Posts</HeaderLink></li>
			<li><HeaderLink href="/books">Books</HeaderLink></li>
			<li><HeaderLink href="/websites">Links</HeaderLink></li>
			<li><HeaderLink href="/uses">Uses</HeaderLink></li>
			<li><HeaderLink href="/about">About</HeaderLink></li>
		</ul>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 10px rgba(var(--black), 15%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		grid-column: 1;
		justify-self: start;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav :global(a) {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav :global(a:hover) {
		color: var(--orange);
	}
	nav :global(a.active) {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.internal-links {
		display: flex;
		grid-column: 2;
		justify-self: center;
	}

	/* Hamburger button and dropdown, hidden until small screens */
	#menuToggle {
		display: none;
	}
	#menu {
		display: none;
	}

	@media (max-width: 720px) {
		header {
			padding: 1em;
		}

		nav {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 0.75em;
		}

		.internal-links {
			display: none;
		}

		#menuToggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			order: -1;
			position: relative;
			width: 30px;
			height: 30px;
			cursor: pointer;
			-webkit-user-select: none;
			-moz-user-select: none;
			-ms-user-select: none;
			user-select: none;
		}

		#menuToggle input {
			position: absolute;
			inset: 0;
			margin: 0;
			opacity: 0;
			cursor: pointer;
			z-index: 2;
		}

		/* Hamburger bars */
		#menuToggle span {
			display: block;
			width: 100%;
			height: 2px;
			margin-bottom: 6px;
			background: rgb(var(--black));
			border-radius: 3px;
			transition: background 0.3s ease;
		}
		#menuToggle span:last-child {
			margin-bottom: 0;
		}

		/* Change the color of the hamburger when toggled */
		#menuToggle:has(input:checked) span {
			background: var(--accent);
		}

		/* Menu panel, a dropdown spanning the full header width */
		#menu {
			display: block;
			position: absolute;
			top: 100%;
			left: -1em;
			right: -1em;
			margin: 0;
			padding: 0;
			list-style-type: none;
			background: white;
			box-shadow: 0 2px 10px rgba(var(--black), 15%);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}

		#menu li {
			padding: 0;
		}

		#menu :global(a) {
			display: block;
			padding: 0.75em 1.5em;
			border-bottom: 4px solid transparent;
		}

		/* Reveal the menu when the checkbox is checked */
		#menuToggle:has(input:checked) ~ #menu {
			max-height: 60vh;
			overflow-y: auto;
		}
	}
</style>
