---
import { SITE_TITLE } from "../consts";
import GithubIcon from "../assets/icons/github.svg";
import HeaderLink from "./HeaderLink.astro";

const pages = [
	{ href: "/", label: "home" },
	{ href: "/blog", label: "posts" },
	{ href: "/books", label: "books" },
	{ href: "/websites", label: "links" },
	{ href: "/uses", label: "uses" },
	{ href: "/about", label: "about" },
];
---

<header>
	<nav role="navigation">
		<label id="menuToggle" for="menu-checkbox" aria-label="Toggle menu">
			<input id="menu-checkbox" type="checkbox" />
			<span></span>
			<span></span>
			<span></span>
		</label>
		<div class="tags">
			{
				pages.map((page) => (
					<HeaderLink href={page.href}>{page.label}</HeaderLink>
				))
			}
		</div>
		<button
			type="button"
			class="layout"
			id="layout-toggle"
			title="Change layout"
			aria-label="Change layout">[]=</button
		>
		<div class="dwm-active-window">
			<h2>
				<a href="/" class="site-title">
					<svg
						class="site-icon"
						aria-hidden="true"
						viewBox="0 0 64 64"
						width="22"
						height="22"
					>
						<rect width="64" height="64" rx="14" fill="#151515"
						></rect>
						<path
							d="M13 17h26M26 17v31"
							fill="none"
							stroke="#e8e8e8"
							stroke-width="8"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
						<rect
							x="40"
							y="41"
							width="14"
							height="8"
							rx="2"
							fill="#5b8fc7"></rect>
					</svg>
					{SITE_TITLE}
				</a>
			</h2>
		</div>
		<div class="status">
			<a href="/rss.xml" class="rss">rss</a><span class="status-separator"
				>|
			</span>
			<a href="https://github.com/tcvscheppingen" class="rss"> GitHub </a>
		</div>
		<!-- On small screens the tags move into this dropdown, like a dmenu list -->
		<ul id="menu">
			{
				pages.map((page) => (
					<li>
						<HeaderLink href={page.href}>{page.label}</HeaderLink>
					</li>
				))
			}
		</ul>
	</nav>
	<!-- The layout notification, styled after dunst in DARBS -->
	<div id="layout-notice" class="notice" role="status" hidden>
		<strong id="layout-notice-title"></strong>
		<span id="layout-notice-body"></span>
	</div>
</header>

<style>
	header {
		--bar-height: 40px;
		margin: 0;
		background: var(--bar-bg);
		border-bottom: 1px solid var(--bar-line);
		font-family:
			ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
			monospace;
		font-size: 15px;
		line-height: 1;
	}
	nav {
		position: relative;
		display: flex;
		align-items: stretch;
		height: var(--bar-height);
		color: var(--bar-fg);
	}
	nav :global(a) {
		display: flex;
		align-items: center;
		color: var(--bar-fg);
		text-decoration: none;
	}
	nav :global(a:hover) {
		text-decoration: none;
		color: var(--bar-fg);
		background: rgba(var(--gray), 20%);
	}

	/* Tags: the current page is the selected tag */
	.tags {
		display: flex;
	}
	.tags :global(a),
	#menu :global(a) {
		padding: 0 0.9em;
	}
	.tags :global(a.active),
	#menu :global(a.active),
	.tags :global(a.active:hover),
	#menu :global(a.active:hover) {
		background: var(--sel-bg);
		color: var(--sel-fg);
		font-weight: normal;
		text-decoration: none;
	}

	.layout {
		display: flex;
		align-items: center;
		padding: 0 0.9em;
		white-space: pre;
		background: none;
		border: none;
		color: var(--bar-fg);
		font: inherit;
		cursor: pointer;
	}
	.layout:hover {
		background: rgba(var(--gray), 20%);
	}
	.layout:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	/* dunst in DARBS: top right, 10px from the edges, 350px wide, a 3px
	   steel-blue frame, square corners */
	.notice {
		position: fixed;
		top: calc(var(--bar-height) + 10px);
		right: 10px;
		z-index: 20;
		display: grid;
		gap: 0.2em;
		width: 350px;
		max-width: calc(100vw - 20px);
		box-sizing: border-box;
		padding: 10px;
		background: var(--bg);
		border: 3px solid var(--accent-line);
		color: var(--bar-fg);
		font-size: 14px;
		line-height: 1.5;
	}
	.notice[hidden] {
		display: none;
	}

	h2 {
		display: flex;
		flex: 1;
		min-width: 0;
		margin: 0;
		font-size: 1em;
		font-weight: normal;
	}
	.site-title {
		gap: 0.6em;
		min-width: 0;
		padding: 0 0.9em 0 0;
		white-space: nowrap;
	}
	.site-title:hover {
		background: none;
	}
	.site-icon {
		flex: none;
	}

	.dwm-active-window {
		display: flex;
		flex: 1;
		min-width: 0;
		margin: 0;
		font-size: 1em;
		font-weight: normal;
		background: var(--sel-bg);
		padding-left: 0.9em;
	}

	/* Status text, like dwmblocks */
	.status {
		display: flex;
		align-items: stretch;
	}
	.status-separator {
		display: flex;
		align-items: center;
	}
	.rss {
		padding: 0 0.9em;
	}

	/* Hamburger button and dropdown, hidden until small screens */
	#menuToggle {
		display: none;
	}
	#menu {
		display: none;
	}

	@media (max-width: 720px) {
		.tags,
		.layout,
		.rss {
			display: none;
		}

		.site-title {
			padding-left: 0;
		}

		/* Too narrow for the icon and the name on one line */
		@media (max-width: 380px) {
			.site-title {
				white-space: normal;
				line-height: 1.1;
			}
		}

		#menuToggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 4px;
			position: relative;
			width: var(--bar-height);
			padding: 0 11px;
			box-sizing: border-box;
			cursor: pointer;
			user-select: none;
		}

		#menuToggle input {
			position: absolute;
			inset: 0;
			margin: 0;
			opacity: 0;
			cursor: pointer;
			z-index: 2;
		}

		/* Hamburger bars */
		#menuToggle span {
			display: block;
			height: 2px;
			background: var(--bar-fg);
		}

		/* An open menu marks the button like a selected tag */
		#menuToggle:has(input:checked) {
			background: var(--sel-bg);
		}
		#menuToggle:has(input:checked) span {
			background: var(--sel-fg);
		}

		/* The dropdown: a vertical list like dmenu -l */
		#menu {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			z-index: 10;
			margin: 0;
			padding: 0;
			list-style-type: none;
			background: var(--bar-bg);
			border-bottom: 1px solid var(--bar-line);
			max-height: 0;
			overflow: hidden;
			visibility: hidden;
		}

		#menu li {
			padding: 0;
		}

		#menu :global(a) {
			height: var(--bar-height);
		}

		/* Reveal the menu when the checkbox is checked */
		#menuToggle:has(input:checked) ~ #menu {
			max-height: 60vh;
			overflow-y: auto;
			visibility: visible;
		}
	}
</style>

<script>
	// dwm layouts from DARBS. With one window open most of them look the same,
	// so these four change the page window in a way you can see.
	const layouts = [
		{
			symbol: "[]=",
			name: "tile",
			body: "Master and stack. With one window, that's just the master.",
		},
		{
			symbol: "[M]",
			name: "monocle",
			body: "One window, full screen. Nothing else to look at.",
		},
		{
			symbol: "|M|",
			name: "centeredmaster",
			body: "The master in the middle, with room for a stack on both sides.",
		},
		{
			symbol: "><>",
			name: "floating",
			body: "Floating like in a desktop environment. Very un-dwm.",
		},
	];
	const toggle = document.getElementById("layout-toggle");
	const notice = document.getElementById("layout-notice");
	const noticeTitle = document.getElementById("layout-notice-title");
	const noticeBody = document.getElementById("layout-notice-body");
	let current = 0;
	let hideTimer: ReturnType<typeof setTimeout> | undefined;

	toggle?.addEventListener("click", () => {
		current = (current + 1) % layouts.length;
		const layout = layouts[current];
		toggle.textContent = layout.symbol;
		document.documentElement.dataset.layout = layout.name;
		if (notice && noticeTitle && noticeBody) {
			noticeTitle.textContent = `dwm: ${layout.symbol} ${layout.name}`;
			noticeBody.textContent = layout.body;
			notice.hidden = false;
			clearTimeout(hideTimer);
			hideTimer = setTimeout(() => (notice.hidden = true), 4000);
		}
	});
</script>
