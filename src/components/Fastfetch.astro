---
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).filter(
	(post) => post.data.pubDate.valueOf() <= Date.now(),
);
// The pages in src/pages, plus the posts page in src/pages/blog
const pages =
	(await readdir(join(process.cwd(), "src/pages"))).filter((file) =>
		file.endsWith(".astro"),
	).length + 1;
// Uptime counts from the first post
const firstPost = new Date(
	Math.min(...posts.map((post) => post.data.pubDate.valueOf())),
);

// The favicon: a T and a blue cursor on a dark, rounded square
const t = (text: string) => `<span class="logo-t">${text}</span>`;
const cursor = (text: string) => `<span class="logo-cursor">${text}</span>`;
const stem = " ".repeat(8) + t("███");
const logo = [
	"╭────────────────────────╮",
	"│                        │",
	"│                        │",
	`│   ${t("█".repeat(13))}        │`,
	`│${stem}             │`,
	`│${stem}             │`,
	`│${stem}             │`,
	`│${stem}             │`,
	`│${stem}    ${cursor("▄▄▄▄▄")}    │`,
	`│${stem}    ${cursor("█████")}    │`,
	"│                        │",
	"│                        │",
	"╰────────────────────────╯",
].join("\n");

// [key, value]; values with an id are filled in by the script below
const info: [string, string, string?][] = [
	["OS", "DARBS (in your browser)"],
	["Kernel", "Astro"],
	["Uptime", "", "fastfetch-uptime"],
	["Packages", `${posts.length} (posts), ${pages} (pages)`],
	["Shell", "keybinds (press ?)"],
	["Display", "", "fastfetch-display"],
	["WM", "", "fastfetch-wm"],
	["Theme", "Steel"],
	["Font", "Atkinson Hyperlegible"],
	["Terminal", "st"],
	["Wallpaper", "Cosmic Cliffs (NASA, ESA, CSA, STScI)"],
	["Cookies", "0"],
	["Trackers", "0"],
];
---

<section
	id="fastfetch"
	class="fastfetch"
	aria-labelledby="fastfetch-title"
	data-first-post={firstPost.toISOString()}
	tabindex="-1"
	hidden
>
	<p class="prompt" aria-hidden="true">
		<span class="user">[thymen@thymen.dev ~]</span><span class="sign"
			>$</span
		> fastfetch
	</p>
	<div class="output">
		<pre class="logo" aria-hidden="true" set:html={logo} />
		<div class="info">
			<h2 id="fastfetch-title">
				<span class="key">thymen</span>@<span class="key"
					>thymen.dev</span
				>
			</h2>
			<p aria-hidden="true">{"-".repeat("thymen@thymen.dev".length)}</p>
			{
				info.map(([key, value, id]) => (
					<p>
						<span class="key">{key}</span>:{" "}
						<span id={id}>{value}</span>
					</p>
				))
			}
			<p class="colors" aria-hidden="true">
				{Array.from({ length: 8 }, () => <span />)}
			</p>
		</div>
	</div>
	<p class="prompt">
		<span class="user" aria-hidden="true">[thymen@thymen.dev ~]</span><span
			class="sign"
			aria-hidden="true">$</span
		>{" "}
	</p>
</section>

<style>
	.fastfetch {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		background: var(--term-bg);
		border: var(--term-border) solid var(--accent-line);
		color: rgb(var(--gray-dark));
		font-family:
			ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
			monospace;
		font-size: 14px;
		line-height: 1.4;
		outline: none;
		overflow-y: auto;
	}
	.fastfetch[hidden] {
		display: none;
	}
	.prompt {
		margin: 0;
		padding: 1em 1.4em 0;
		overflow-wrap: anywhere;
	}
	.prompt:last-child {
		padding-bottom: 1em;
	}
	.user {
		color: var(--green);
	}
	.sign {
		color: var(--accent);
	}
	/* Next to each other like in a terminal; under each other when the window
	   is too narrow */
	.output {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 1em 3ch;
		padding: 1em 1.4em 0;
	}
	.logo {
		margin: 0;
		padding: 0;
		border-radius: 0;
		color: rgb(var(--gray));
		font: inherit;
		/* No gaps between the rows of blocks */
		line-height: 1;
		overflow: visible;
	}
	.logo :global(.logo-t) {
		color: rgb(var(--black));
	}
	.logo :global(.logo-cursor) {
		color: var(--accent);
	}
	.info {
		min-width: 0;
	}
	.info p,
	h2 {
		margin: 0;
		overflow-wrap: anywhere;
	}
	h2 {
		color: rgb(var(--gray-dark));
		font-size: 1em;
		font-weight: normal;
	}
	.key {
		color: var(--accent);
		font-weight: 700;
	}
	.colors {
		display: flex;
		margin-top: 1em !important;
	}
	/* The color blocks: Steel's colors. In CSS, as the Content-Security-Policy
	   doesn't allow style attributes */
	.colors span {
		width: 3ch;
		height: 1.4em;
	}
	.colors span:nth-child(1) {
		background: var(--bg);
	}
	.colors span:nth-child(2) {
		background: var(--red);
	}
	.colors span:nth-child(3) {
		background: var(--green);
	}
	.colors span:nth-child(4) {
		background: var(--yellow);
	}
	.colors span:nth-child(5) {
		background: var(--accent);
	}
	.colors span:nth-child(6) {
		background: var(--violet);
	}
	.colors span:nth-child(7) {
		background: var(--cyan);
	}
	.colors span:nth-child(8) {
		background: rgb(var(--gray-dark));
	}
	button {
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}
	button:hover,
	button:focus-visible {
		background: var(--sel-bg);
		color: var(--sel-fg);
		outline: none;
	}
</style>

<script>
	// The values that change: how long since the first post, the size of the
	// window and the dwm layout. Only shown to you, never sent anywhere
	const root = document.documentElement;
	const fastfetch = document.getElementById("fastfetch") as HTMLElement;
	const uptime = document.getElementById("fastfetch-uptime");
	const display = document.getElementById("fastfetch-display");
	const wm = document.getElementById("fastfetch-wm");
	const firstPost = new Date(fastfetch.dataset.firstPost ?? "");
	const layouts: Record<string, string> = {
		tile: "[]=",
		monocle: "[M]",
		centeredmaster: "|M|",
		floating: "><>",
	};

	// Like fastfetch: "12 days, 3 hours, 4 mins"
	function since(date: Date) {
		const mins = Math.max(
			0,
			Math.floor((Date.now() - date.valueOf()) / 60000),
		);
		const parts = [
			[Math.floor(mins / 1440), "day"],
			[Math.floor(mins / 60) % 24, "hour"],
			[mins % 60, "min"],
		] as const;
		return (
			parts
				.filter(([n]) => n > 0)
				.map(([n, unit]) => `${n} ${unit}${n === 1 ? "" : "s"}`)
				.join(", ") || "0 mins"
		);
	}

	function update() {
		if (fastfetch.hidden) return;
		if (uptime) uptime.textContent = since(firstPost);
		if (display)
			display.textContent = `${window.innerWidth}x${window.innerHeight}`;
		const layout = root.dataset.layout ?? "tile";
		if (wm) wm.textContent = `dwm (${layouts[layout] ?? "[]="} ${layout})`;
	}

	update();
	window.addEventListener("resize", update);
	new MutationObserver(update).observe(root, {
		attributeFilter: ["data-layout"],
	});
	new MutationObserver(update).observe(fastfetch, {
		attributeFilter: ["hidden"],
	});
	setInterval(update, 60000);
</script>
