---
import { Image } from "astro:assets";

const { imageSrc, altText, width = 1020, height = 510 } = Astro.props;
---

<Image src={imageSrc} alt={altText} width={width} height={height} />
<style>
    .hero-image {
        width: 100%;
    }
    .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
    }
</style>
