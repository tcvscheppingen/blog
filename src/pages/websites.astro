---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <h1>Websites</h1>
            <p>Here are some websites that I like:</p>
            <h3>Interesting websites</h3>
            <ul>
                <li>
                    <a href="https://www.privacyguides.org/">Privacy Guides</a> information
                    on improving privacy.
                </li>
                <li>
                    <a href="https://european-alternatives.eu/"
                        >European Alternatives</a
                    > list of alternatives to American software/services.
                </li>
                <li>
                    <a href="https://darknetdiaries.com/"
                        >Darknet Diaries Podcast</a
                    > interesting podcast about cybersecurity.
                </li>
                <li>
                    <a href="https://calnewport.com/">Cal Newport Blog</a> author
                    of <i>Digital Minimalism</i> and other books.
                </li>
                <li>
                    <a href="https://selfh.st/apps/">Self Hosting Services</a> list
                    of apps that can be self-hosted.
                </li>
            </ul>
            <h3>Software</h3>
            <ul>
                <li>
                    <a href="https://mullvad.net/en">Mullvad VPN</a> privacy focused
                    VPN.
                </li>
                <li>
                    <a href="https://mullvad.net/en/browser">Mullvad Browser</a> developed
                    by Mullvad and the TOR project.
                </li>
                <li>
                    <a href="https://librewolf.net/">LibreWolf Browser</a> privacy
                    focused fork of FireFox.
                </li>
                <li>
                    <a href="https://signal.org/">Signal</a> privacy focused messaging
                    app.
                </li>
                <li>
                    <a href="https://joplinapp.org/">Joplin</a> open source note-taking
                    app.
                </li>
                <li>
                    <a href="https://vscodium.com/">VsCodium</a> fork of Visual Studio
                    Code with telemetry removed.
                </li>
                <li>
                    <a href="https://e.foundation/e-os/">/e/OS</a> deGoogled alternative
                    to Android.
                </li>
            </ul>
            <h3>Privacy focused services</h3>
            <ul>
                <li>
                    <a href="https://www.startpage.com/">StartPage</a> search engine
                    based in The Netherlands.
                </li>
                <li>
                    <a href="https://duckduckgo.com/">DuckDuckGo</a> search engine.
                </li>
                <li>
                    <a href="https://tuta.com/">Tuta Mail</a> European email provider
                    based Germany.
                </li>
                <li>
                    <a href="https://proton.me/mail">ProtonMail</a> European email
                    provider based in Switzerland.
                </li>
            </ul>
            <h3>Self hosted applications</h3>
            <ul>
                <li>
                    <a href="https://nextcloud.com/home-users/">NextCloud</a> Google
                    Drive or iCloud alternative.
                </li>
                <li>
                    <a href="https://immich.app/">Immich</a> Google Photos alternative.
                </li>

                <li>
                    <a href="https://pi-hole.net/">PiHole</a> local DNS for blocking
                    ads and trackers.
                </li>

                <li>
                    <a href="https://docs.searxng.org">SearXNG</a> meta-search engine
                </li>
                <li>
                    <a href="https://forgejo.org/">ForgeJo</a> GitHub alternative.
                </li>
                <li>
                    <a href="https://about.gitea.com/">Gitea</a> GitHub alternative.
                </li>
                <li>
                    <a href="https://www.navidrome.org/">Navidrome</a> alternative
                    to music streaming services.
                </li>
                <li>
                    <a
                        href="https://www.selfhostedninja.com/joplin-server-a-complete-checklist-for-self-hosting-success/"
                        >Joplin server (tutorial)</a
                    > server for storing Joplin notes.
                </li>
            </ul>
        </main>
    </body>
</html>
