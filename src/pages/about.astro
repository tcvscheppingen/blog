---
import AboutHeroImage from "../assets/me.jpeg";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { Image } from "astro:assets";

const options: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "long",
};

function getDurationInYears(startDate: Date, endDate: Date) {
	let timeDifference = endDate.getTime() - startDate.getTime();
	return timeDifference / (1000 * 60 * 60 * 24) / 365;
}

function formatDate(date: Date) {
	return date.toLocaleDateString("en-GB", options);
}

const workExperienceStartingDate = new Date(2021, 1, 3);
const currentDate = new Date(Date.now());
const workExperienceInYears = Math.round(
	getDurationInYears(workExperienceStartingDate, currentDate),
);

const intusDeveloperStartDate = formatDate(new Date(2025, 9, 1));
const intusTesterStartDate = formatDate(new Date(2024, 8, 1));
const intusTesterEndate = formatDate(new Date(2025, 9, 30));
const nvwaStartDate = formatDate(new Date(2024, 1, 1));
const nvwaEndDate = formatDate(new Date(2024, 5, 30));
const intusInternshipStartDate = formatDate(new Date(2023, 8, 1));
const intusIntershipEndDate = formatDate(new Date(2024, 0, 31));
const q2SoftwareStartDate = formatDate(new Date(2022, 6, 1));
const q2SoftwareEndDate = formatDate(new Date(2024, 7, 31));
const cellroStartDate = formatDate(new Date(2022, 2, 1));
const cellroEndDate = formatDate(new Date(2022, 6, 31));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image={AboutHeroImage}
		/>
	</head>
	<body>
		<NavBar />
		<h2>About me</h2>
		<div>
			<Image
				src={AboutHeroImage}
				alt="A picture of me"
				class="about-image"
			/>
		</div>
		<main>
			<div class="about-text">
				<p>
					I am a developer who enjoys running, programming, reading
					and good coffee. Topics I am interested in are: privacy,
					security and programming. I graduated in 2024 with a
					bachelor's degree in Information and Communication
					Technology from the Ede Christian University of Applied
					Sciences.
				</p>
				<p>
					My journey as a developer started in elementary school when
					I took a course in plain HTML. Later I taught myself Python
					by downloading public domain datasets and analyzing them
					with Pandas and Numpy. I worked at a startup as a full-stack
					Laravel developer with a focus on back-end and quality
					control. After that I worked as a software tester for a
					company developing workforce management software. Right now
					I work as a full-stack Java/Vue developer for the same
					company.
				</p>
			</div>
			<p>
				Below is an overview of my ~{workExperienceInYears} years of work
				experience:<br />
				<i
					>(Please note that part time positions are concurrent with
					internships)</i
				>
			</p>
		</main>
		<div class="experience-table">
			<table class="work-xp">
				<tr>
					<th>Company</th>
					<th>Role</th>
					<th class="employment-type-column">Employment type</th>
					<th class="start-date-column">Start date</th>
					<th class="end-date-column">End date</th>
				</tr>
				<tr>
					<td>Intus Workforce Solutions</td>
					<td>Software Developer</td>
					<td class="employment-type-column">Full Time</td>
					<td class="start-date-column">{intusDeveloperStartDate}</td>
					<td class="end-date-column">--</td>
				</tr>
				<tr>
					<td>Intus Workforce Solutions</td>
					<td>Software Tester</td>
					<td class="employment-type-column">Full Time</td>
					<td class="start-date-column">{intusTesterStartDate}</td>
					<td class="end-date-column">{intusTesterEndate}</td>
				</tr>
				<tr>
					<td>Nederlandse Voedsel- en Warenautoriteit</td>
					<td>Software Developer</td>
					<td class="employment-type-column">Internship</td>
					<td class="start-date-column">{nvwaStartDate}</td>
					<td class="end-date-column">{nvwaEndDate}</td>
				</tr>
				<tr>
					<td>Intus Workforce Solutions</td>
					<td>Software Developer</td>
					<td class="employment-type-column">Internship</td>
					<td class="start-date-column">{intusInternshipStartDate}</td
					>
					<td class="end-date-column">{intusIntershipEndDate}</td>
				</tr>
				<tr>
					<td>Q2-software</td>
					<td>Laravel Developer</td>
					<td class="employment-type-column">Part Time</td>
					<td class="start-date-column">{q2SoftwareStartDate}</td>
					<td class="end-date-column">{q2SoftwareEndDate}</td>
				</tr>
				<tr>
					<td>Cellro | CNC Automation</td>
					<td>Software Developer</td>
					<td class="employment-type-column">Internship</td>
					<td class="start-date-column">{cellroStartDate}</td>
					<td class="end-date-column">{cellroEndDate}</td>
				</tr>
			</table>
		</div>
		<Footer />
	</body>
</html>
<style>
	.about-image {
		display: block;
		padding-top: 20px;
		margin-left: auto;
		margin-right: auto;
		width: 20%;
		height: auto;
		border-radius: 5px;
	}

	h2 {
		display: flex;
		justify-content: center;
		align-items: center;
		padding-top: 20px;
	}

	.experience-table {
		width: 80%;
		display: block;
		margin-left: auto;
		margin-right: auto;
		overflow-x: auto;
		padding-bottom: 20pt;
	}

	table {
		border-collapse: collapse;
	}

	tr {
		border-bottom: 1px solid rgb(var(--gray-dark));
	}

	object.email {
		height: 2em;
		margin: -1em 0;
		vertical-align: middle;
	}
	main {
		width: 50%;
	}

	@media (max-width: 720px) {
		.about-image {
			display: block;
			padding-top: 20px;
			margin-left: auto;
			margin-right: auto;
			width: 60%;
			height: auto;
			border-radius: 5px;
		}

		main {
			width: 80%;
		}

		/* table {
			border-collapse: separate;
		} */

		th,
		td {
			font-size: 16px;
			box-shadow: 2px 2px 3px lightgray;
			border-radius: 5px;
			border: 1pt;
			border-style: solid;
			padding-left: 5pt;
			border-color: gray;
		}
	}
</style>
