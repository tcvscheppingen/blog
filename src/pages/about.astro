---
import AboutHeroImage from "../assets/me.jpeg";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import TerminalPrompt from "../components/TerminalPrompt.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { Image } from "astro:assets";

function getDurationInYears(startDate: Date, endDate: Date) {
	let timeDifference = endDate.getTime() - startDate.getTime();
	return timeDifference / (1000 * 60 * 60 * 24) / 365;
}

// "Oct 2025"
function formatDate(date: Date) {
	return date.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
}

const workExperienceStartingDate = new Date(2021, 1, 3);
const currentDate = new Date(Date.now());
const workExperienceInYears = Math.round(
	getDurationInYears(workExperienceStartingDate, currentDate),
);

// Newest first; no end date means the current job
const experience = [
	{ company: "Intus Workforce Solutions", role: "Software Developer", type: "Full time", start: new Date(2025, 9, 1) },
	{ company: "Intus Workforce Solutions", role: "Software Tester", type: "Full time", start: new Date(2024, 8, 1), end: new Date(2025, 9, 30) },
	{ company: "Nederlandse Voedsel- en Warenautoriteit", role: "Software Developer", type: "Internship", start: new Date(2024, 1, 1), end: new Date(2024, 5, 30) },
	{ company: "Intus Workforce Solutions", role: "Software Developer", type: "Internship", start: new Date(2023, 8, 1), end: new Date(2024, 0, 31) },
	{ company: "Q2-software", role: "Laravel Developer", type: "Part time", start: new Date(2022, 6, 1), end: new Date(2024, 7, 31) },
	{ company: "Cellro | CNC Automation", role: "Software Developer", type: "Internship", start: new Date(2022, 2, 1), end: new Date(2022, 6, 31) },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image={AboutHeroImage}
		/>
	</head>
	<body>
		<NavBar />
		<main>
			<TerminalPrompt />
			<h2>About me</h2>
			<div>
				<Image
					src={AboutHeroImage}
					alt="A picture of me"
					class="about-image"
				/>
			</div>
			<div class="about-text">
				<p>
					I am a developer who enjoys running, programming, reading
					and good coffee. Topics I am interested in are: privacy,
					security and programming. I graduated in 2024 with a
					bachelor's degree in Information and Communication
					Technology from the Ede Christian University of Applied
					Sciences.
				</p>
				<p>
					My journey as a developer started in elementary school when
					I took a course in plain HTML. Later I taught myself Python
					by downloading public domain datasets and analyzing them
					with Pandas and Numpy. I worked at a startup as a full-stack
					Laravel developer with a focus on back-end and quality
					control. After that I worked as a software tester for a
					company developing workforce management software. Right now
					I work as a full-stack Java/Vue developer for the same
					company.
				</p>
			</div>
			<p>
				Below is an overview of my ~{workExperienceInYears} years of work
				experience, including internships while studying:
			</p>
			<ol class="experience">
				{
					experience.map((job) => (
						<li class:list={{ current: !job.end }}>
							<span class="period">
								{formatDate(job.start)} – {job.end ? formatDate(job.end) : "now"}
							</span>
							<span class="role">{job.role}</span>
							<span class="company">
								{job.company} · {job.type}
							</span>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>
<style>
	.about-image {
		display: block;
		padding-top: 20px;
		margin-left: auto;
		margin-right: auto;
		width: 30%;
		height: auto;
		border-radius: 5px;
	}

	h2 {
		display: flex;
		justify-content: center;
		align-items: center;
		padding-top: 20px;
	}

	/* Work experience as a timeline: a steel-blue line with a dot per job,
	   filled for the current one */
	.experience {
		list-style: none;
		margin: 1em auto 0;
		padding: 0;
	}
	.experience li {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 0 0 1.4em 1.6em;
		border-left: 2px solid var(--accent-line);
		margin-left: 6px;
	}
	.experience li:last-child {
		border-left-color: transparent;
		padding-bottom: 0;
	}
	.experience li::before {
		content: "";
		position: absolute;
		left: -8px;
		top: 0.35em;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 2px solid var(--accent-line);
		background: var(--bg);
	}
	.experience li.current::before {
		background: var(--accent);
	}
	.period {
		font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
		font-size: 0.75em;
		line-height: 1.6;
		color: rgb(var(--gray));
	}
	.role {
		color: rgb(var(--black));
		font-weight: 700;
		line-height: 1.4;
	}
	.company {
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	object.email {
		height: 2em;
		margin: -1em 0;
		vertical-align: middle;
	}

	@media (max-width: 720px) {
		.about-image {
			display: block;
			padding-top: 20px;
			margin-left: auto;
			margin-right: auto;
			width: 60%;
			height: auto;
			border-radius: 5px;
		}
	}
</style>
