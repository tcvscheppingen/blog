---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import FallbackImage from "../../assets/hero-images/fallback.jpg";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import TerminalPrompt from "../../components/TerminalPrompt.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

// Retrieve only blogposts that are on or before the current date.
const posts = await Promise.all(
	(await getCollection("blog"))
		.filter((post) => post.data.pubDate.valueOf() <= Date.now())
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.map(async (post) => {
			const { remarkPluginFrontmatter } = await render(post);
			// "3 min read" -> "3 min", where newsboat shows the length
			const minutes = String(remarkPluginFrontmatter.minutesRead ?? "").replace(" read", "");
			return { post, minutes };
		}),
);

// newsboat's default date format: "%b %d"
const shortDate = (date: Date) =>
	date.toLocaleDateString("en-US", { month: "short", day: "2-digit" });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* The post list, styled after newsboat in a terminal: the info bar on
			   top, one entry per article with the focused one highlighted, and the
			   key help at the bottom. Unlike newsboat, every entry has a thumbnail
			   and the search prompt sits on top, where it is easy to reach. */
			main {
				--content-width: 100%;
				display: flex;
				flex-direction: column;
				padding-bottom: 1em;
			}
			.newsboat {
				display: flex;
				flex: 1;
				flex-direction: column;
				width: 100%;
				font-family:
					ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas,
					monospace;
				font-size: 15px;
				line-height: 1.6;
			}
			.info,
			.help {
				margin: 0;
				padding: 0 1ch;
				background: var(--sel-bg);
				color: var(--sel-fg);
				font-weight: 700;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.help {
				margin-top: 1em;
			}
			.help kbd {
				font-family: inherit;
			}
			/* The prompt newsboat shows on / */
			.search {
				display: flex;
				gap: 1ch;
				margin-bottom: 0.5em;
				padding: 0.2em 1ch;
				border-bottom: 1px solid var(--bar-line);
			}
			#search {
				flex: 1;
				min-width: 0;
				padding: 0;
				border: none;
				outline: none;
				background: none;
				color: rgb(var(--black));
				font: inherit;
				font-size: 16px;
			}
			#search::placeholder {
				color: rgb(var(--gray));
			}
			.articles {
				flex: 1;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.articles a {
				display: grid;
				grid-template-columns: 3ch 1ch 176px minmax(0, 1fr);
				gap: 2ch;
				align-items: center;
				padding: 0.5em 1ch;
				color: rgb(var(--black));
				text-decoration: none;
			}
			.articles a:hover {
				background: rgba(var(--gray), 20%);
			}
			.articles li.focus a {
				background: var(--sel-bg);
				color: var(--sel-fg);
			}
			.index {
				color: rgb(var(--gray));
				text-align: right;
			}
			/* Unread articles get an N, like in newsboat. Visited links can only
			   change color, so a read article's N takes the color of the row */
			.flag {
				color: var(--yellow);
				font-weight: 700;
			}
			.articles a:visited .flag {
				color: var(--bg);
			}
			.articles li.focus a:visited .flag {
				color: var(--sel-bg);
			}
			.thumb {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				border-radius: 4px;
			}
			.entry {
				display: grid;
				gap: 0.2em;
				min-width: 0;
			}
			.title {
				font-weight: 700;
			}
			.articles a:visited .title {
				color: rgb(var(--gray));
			}
			.articles li.focus a:visited .title {
				color: var(--sel-fg);
			}
			.meta,
			.description {
				color: rgb(var(--gray));
			}
			.description {
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				line-clamp: 2;
				overflow: hidden;
			}
			.tags {
				color: var(--cyan);
			}
			.articles li.focus :is(.index, .meta, .description, .tags) {
				color: inherit;
			}
			#no-results {
				margin: 0;
				padding: 0 1ch;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				/* The thumbnail on top, full width; the N and the title below it */
				.articles a {
					grid-template-columns: 1ch minmax(0, 1fr);
					gap: 0.5em 1ch;
					align-items: start;
					padding: 0.6em 0 1em;
				}
				.thumb {
					grid-column: 1 / -1;
					grid-row: 1;
				}
				.index,
				.description,
				.help {
					display: none;
				}
				.info {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<NavBar />
		<main>
			<TerminalPrompt />
			<section class="newsboat">
				<p class="info">
					newsboat - Articles in feed '{SITE_TITLE}' (<span id="count"
						>{posts.length}</span
					>{" "}total) - {new URL("rss.xml", Astro.site)}
				</p>
				<div class="search">
					<label for="search">Search for:</label>
					<input
						id="search"
						type="search"
						enterkeyhint="search"
						placeholder="title, description or tag"
						autocomplete="off"
						spellcheck="false"
					/>
				</div>
				<ol class="articles">
					{
						posts.map(({ post, minutes }, index) => (
							<li
								data-search={[
									post.data.title,
									post.data.description,
									...(post.data.tags ?? []),
								]
									.join(" ")
									.toLowerCase()}
							>
								<a href={`/blog/${post.id}/`} data-astro-prefetch>
									<span class="index">{index + 1}</span>
									<span class="flag">N</span>
									<Image
										class="thumb"
										src={post.data.heroImage ?? FallbackImage}
										alt=""
										width={352}
										height={176}
										widths={[352, 720, 1080]}
										sizes="(max-width: 720px) calc(100vw - 60px), 176px"
										loading={index < 4 ? "eager" : "lazy"}
									/>
									<span class="entry">
										<span class="title">{post.data.title}</span>
										<span class="meta">
											<time datetime={post.data.pubDate.toISOString()}>
												{shortDate(post.data.pubDate)}
											</time>{" "}
											· {minutes}
											{post.data.tags && (
												<span class="tags">
													{" · "}
													{post.data.tags.map((tag) => `#${tag}`).join(" ")}
												</span>
											)}
										</span>
										<span class="description">{post.data.description}</span>
									</span>
								</a>
							</li>
						))
					}
				</ol>
				<p id="no-results" hidden>No articles match your search.</p>
				<p class="help" aria-hidden="true">
					<kbd>ENTER</kbd>:Open <kbd>j</kbd>:Down <kbd>k</kbd>:Up <kbd>d</kbd>:Search site <kbd
						>/</kbd
					>:Search posts <kbd>?</kbd>:Help
				</p>
			</section>
		</main>
		<Footer />
		<script>
			const input = document.getElementById("search") as HTMLInputElement;
			const items = [...document.querySelectorAll<HTMLLIElement>(".articles > li")];
			const count = document.getElementById("count") as HTMLSpanElement;
			const noResults = document.getElementById("no-results") as HTMLParagraphElement;
			let visible = items;
			let focused = 0;
			// Phones and tablets: no keyboard to move a focus line with, so no
			// newsboat keys, and the keyboard's enter/done key should only close
			// the keyboard
			const touch = window.matchMedia("(hover: none) and (pointer: coarse)");

			// scroll: false when the page loads, so going back to the posts keeps
			// where you were
			function focusArticle(index: number, scroll = true) {
				if (visible.length === 0) return;
				focused = Math.max(0, Math.min(index, visible.length - 1));
				items.forEach((item) => item.classList.remove("focus"));
				visible[focused].classList.add("focus");
				visible[focused].scrollIntoView({ block: "nearest" });
				// The first and last post go to the top and bottom of the window,
				// so the prompt and title above the posts show too. On a desktop
				// the window scrolls, on a phone the page (see global.css)
				if (!scroll || (focused > 0 && focused < visible.length - 1)) return;
				const main = document.querySelector("main");
				const scroller = main && getComputedStyle(main).overflowY !== "visible" ? main : window;
				const bottom = Math.max(main?.scrollHeight ?? 0, document.documentElement.scrollHeight);
				scroller.scrollTo({ top: focused === 0 ? 0 : bottom, behavior: "instant" });
			}

			if (!touch.matches) focusArticle(0, false);

			input.addEventListener("input", () => {
				const query = input.value.toLowerCase().trim();
				visible = items.filter((item) => (item.dataset.search ?? "").includes(query));
				items.forEach((item) => (item.hidden = !visible.includes(item)));
				count.textContent = String(visible.length);
				noResults.hidden = visible.length > 0;
				if (!touch.matches) focusArticle(0);
			});

			// Enter opens the focused article; Esc goes back to the list
			input.addEventListener("keydown", (event) => {
				if (event.key === "Enter") {
					event.preventDefault();
					if (touch.matches) input.blur();
					else visible[focused]?.querySelector("a")?.click();
				} else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
					event.preventDefault();
					focusArticle(focused + (event.key === "ArrowDown" ? 1 : -1));
				} else if (event.key === "Escape") {
					input.blur();
				}
			});

			// newsboat's keys. They run before the site-wide keys (Keybinds.astro),
			// which skip events that are handled here, so j and k move the focus
			// instead of scrolling
			let lastG = 0;
			window.addEventListener(
				"keydown",
				(event) => {
					if (event.ctrlKey || event.metaKey || event.altKey || touch.matches) return;
					if (event.target instanceof HTMLInputElement || document.querySelector("dialog[open]")) return;
					// With the keybinds window focused, the keys are for that window
					if (document.documentElement.dataset.focus === "stack") return;
					switch (event.key) {
						case "j":
						case "ArrowDown":
							focusArticle(focused + 1);
							break;
						case "k":
						case "ArrowUp":
							focusArticle(focused - 1);
							break;
						case "G":
							focusArticle(visible.length - 1);
							break;
						case "g":
							if (event.timeStamp - lastG < 500) focusArticle(0);
							lastG = event.timeStamp;
							break;
						case "Enter":
							// A link focused with Tab opens itself
							if (event.target !== document.body) return;
							visible[focused]?.querySelector("a")?.click();
							break;
						case "/":
							input.focus();
							break;
						default:
							return;
					}
					event.preventDefault();
				},
				{ capture: true },
			);
		</script>
	</body>
</html>
