---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import NavBar from "../../components/NavBar.astro";
import TerminalPrompt from "../../components/TerminalPrompt.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

// Retrieve only blogposts that are on or before the current date.
const posts = (await getCollection("blog"))
	.filter((post) => post.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				--content-width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			/* The search, styled after dmenu in DARBS: the prompt in a blue block,
			   the input, then the matching posts side by side with the selected
			   one highlighted */
			.dmenu {
				display: flex;
				align-items: stretch;
				height: 40px;
				margin-bottom: 1.5rem;
				background: var(--bg);
				border: 1px solid var(--bar-line);
				color: var(--bar-fg);
				font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
				font-size: 15px;
				line-height: 1;
			}
			.dmenu:focus-within {
				border-color: var(--accent-line);
			}
			.dmenu-prompt {
				display: flex;
				align-items: center;
				padding: 0 0.9em;
				background: var(--sel-bg);
				color: var(--sel-fg);
			}
			#search {
				flex: 0 1 18em;
				min-width: 8em;
				padding: 0 0.9em;
				border: none;
				outline: none;
				background: none;
				color: inherit;
				font: inherit;
				appearance: none;
			}
			#search::placeholder {
				color: rgb(var(--gray));
			}
			.dmenu-items {
				display: flex;
				flex: 1;
				min-width: 0;
				overflow: hidden;
			}
			/* The items are created by the script, so the scoped styles need :global */
			/* Post titles are long; cut them off so several fit side by side */
			.dmenu-items :global(a) {
				display: block;
				flex: none;
				max-width: 24ch;
				padding: 0 0.9em;
				line-height: 38px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				color: var(--bar-fg);
				text-decoration: none;
			}
			.dmenu-items :global(a:hover) {
				background: rgba(var(--gray), 20%);
			}
			.dmenu-items :global(a.selected) {
				background: var(--sel-bg);
				color: var(--sel-fg);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
				margin-top: 0.4rem;
			}
			.tag {
				font-size: 0.75rem;
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: var(--cyan);
			}
			#no-results {
				display: none;
				color: rgb(var(--gray));
				padding: 1rem 0;
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1em;
				}
				.tags {
					display: none;
				}
				.dmenu-items {
					display: none;
				}
				#search {
					flex: 1;
				}

				.title {
					font-size: 1em;
				}
			}
		</style>
	</head>
	<body>
		<NavBar />
		<main>
			<TerminalPrompt />
			<section>
				<div class="dmenu">
					<label for="search" class="dmenu-prompt">search</label>
					<input
						id="search"
						type="search"
						placeholder="title, description or tag"
						autocomplete="off"
						spellcheck="false"
					/>
					<div class="dmenu-items" id="dmenu-items" aria-label="Matching posts"></div>
				</div>
				<p id="no-results">No posts match your search.</p>
				<ul class="posts">
					{
						posts.map((post, index) => (
							<li
								data-title={post.data.title.toLowerCase()}
								data-description={post.data.description.toLowerCase()}
								data-tags={(post.data.tags ?? [])
									.join(" ")
									.toLowerCase()}
							>
								<a
									href={`/blog/${post.id}/`}
									data-astro-prefetch
								>
									{post.data.heroImage && (
										<Image
											width={720}
											height={360}
											widths={[480, 720, 960, 1440, 1920]}
											sizes={
												// The newest post's card spans the full width (928px)
												index === 0
													? "(max-width: 720px) 100vw, 928px"
													: "(max-width: 720px) 100vw, 448px"
											}
											src={post.data.heroImage}
											alt=""
											class="hero-image"
										/>
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate
											date={post.data.pubDate}
										/>
									</p>
									{post.data.tags &&
										post.data.tags.length > 0 && (
											<div class="tags">
												{post.data.tags.map((tag) => (
													<span class="tag">
														{tag}
													</span>
												))}
											</div>
										)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const input = document.getElementById("search") as HTMLInputElement;
			const menu = document.getElementById("dmenu-items") as HTMLDivElement;
			// Only the posts: "ul li" would also match the phone menu in the navbar
			const items = document.querySelectorAll<HTMLLIElement>("ul.posts > li");
			const noResults = document.getElementById(
				"no-results",
			) as HTMLParagraphElement;
			let matches: HTMLLIElement[] = [];
			let selected = 0;

			// Like dmenu: the matching posts side by side, the selected one highlighted
			function renderMenu() {
				menu.replaceChildren(
					...matches.map((item, index) => {
						const link = item.querySelector("a") as HTMLAnchorElement;
						const option = document.createElement("a");
						option.href = link.href;
						option.textContent = item.querySelector(".title")?.textContent ?? "";
						option.title = option.textContent;
						if (index === selected) option.className = "selected";
						return option;
					}),
				);
				menu.querySelector(".selected")?.scrollIntoView({ block: "nearest", inline: "nearest" });
			}

			input.addEventListener("input", () => {
				const query = input.value.toLowerCase().trim();
				matches = [];

				items.forEach((item) => {
					const title = item.dataset.title ?? "";
					const description = item.dataset.description ?? "";
					const tags = item.dataset.tags ?? "";
					const isMatch =
						!query ||
						title.includes(query) ||
						description.includes(query) ||
						tags.includes(query);
					item.style.display = isMatch ? "" : "none";
					if (isMatch) matches.push(item);
				});

				noResults.style.display = matches.length === 0 ? "block" : "none";
				// No items while the input is empty, so the bar stays calm
				if (!query) matches = [];
				selected = 0;
				renderMenu();
			});

			// dmenu keys: left/right (and up/down) to select, Enter to open
			input.addEventListener("keydown", (event) => {
				if (matches.length === 0) return;
				if (event.key === "ArrowRight" || event.key === "ArrowDown") {
					selected = (selected + 1) % matches.length;
				} else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
					selected = (selected - 1 + matches.length) % matches.length;
				} else if (event.key === "Enter") {
					const link = matches[selected].querySelector("a");
					if (link) window.location.href = link.href;
				} else {
					return;
				}
				event.preventDefault();
				renderMenu();
			});
		</script>
	</body>
</html>
