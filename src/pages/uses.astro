---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import TerminalPrompt from "../components/TerminalPrompt.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <NavBar />
        <main>
            <TerminalPrompt />
            <h1>Uses</h1>
            <p>Here are some products that I like to use:</p>
            <h3>Hardware</h3>
            <ul>
                <li><a href="/blog/fix-dummy-output-linux/">HP Pavilion cx0670nd</a> - Laptop</li>
                <li>Logitech MX Master 3s - Mouse</li>
                <li>Logitech MX Mechanical Mini - Keyboard</li>
                <li>Akko 3086 - Secondary keyboard</li>
                <li>Moondrop Chu II - IEMs</li>
                <li>Beyerdynamic DT990 Edition - Headphones</li>
                <li>
                    Samsung Galaxy Tab s6 Lite - I replaced Android with /e/os
                </li>
                <li>Snowsky Echo Mini - MP3 Player</li>
            </ul>
            <h3>Software</h3>
            <ul>
                <li>EndeavourOS - OS on HP laptop</li>
                <li><a href="https://github.com/tcvscheppingen/DARBS">DWM</a> - window manager</li>
                <li><a href="/blog/how-to-leave-big-tech/">LibreWolf</a> - browser for daily use</li>
                <li>
                    QuteBrowser - secondary browser for keyboard based browsing
                </li>
                <li><a href="/blog/set-up-neovim-java/">NeoVim</a> - Editor for personal projects</li>
                <li>IntelliJ - IDE for work</li>
            </ul>
        </main>
        <Footer />
    </body>
</html>
