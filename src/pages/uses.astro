---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <NavBar />
        <main>
            <h1>Uses</h1>
            <p>Here are some products that I like to use:</p>
            <h3>Hardware</h3>
            <ul>
                <li>HP Pavilion cx0670nd - Laptop</li>
                <li>Logitech MX Master 3s - Mouse</li>
                <li>Logitech MX Mechanical Mini - Keyboard</li>
                <li>Akko 3086 - Secondary keyboard</li>
                <li>Moondrop Chu II - IEMs</li>
                <li>Beyerdynamic DT990 Edition - Headphones</li>
                <li>
                    Samsung Galaxy Tab s6 Lite - I replaced Android with /e/os
                </li>
                <li>Snowsky Echo Mini - MP3 Player</li>
            </ul>
            <h3>Software</h3>
            <ul>
                <li>Fedora - OS on HP laptop</li>
                <li>KDE Plasma - Desktop environment</li>
                <li>LibreWolf - browser for daily use</li>
                <li>NeoVim - Editor for personal projects</li>
                <li>IntelliJ - IDE for work</li>
            </ul>
        </main>
        <Footer />
    </body>
</html>
