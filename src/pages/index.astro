---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HeroImage from "../components/HeroImage.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import IndexImage from "../assets/index-image.jpeg";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<HeroImage
				imageSrc={IndexImage}
				altText="Computer screens showing code"
			/>
			<h1>My website</h1>

			<p>
				This is my website where I showcase some of the things I like.
				The website focuses on digital privacy, technology skepticism,
				and software development.
			</p>
		</main>

		<Footer />
	</body>
</html>
