---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>My website</h1>
			<p>
				This is my website where I showcase some of the things I like.
				The website focuses on digital privacy, technology skepticism,
				(reformed) theology and development.
			</p>
		</main>
		<Footer />
	</body>
</html>
