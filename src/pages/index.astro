---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import HeroImage from "../components/HeroImage.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import IndexImage from "../assets/index-image.jpeg";
import NavBar from "../components/NavBar.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			ul {
				list-style: none;
			}
		</style>
	</head>
	<body>
		<NavBar />
		<main>
			<HeroImage
				imageSrc={IndexImage}
				altText="Computer screens showing code"
			/>
			<p>
				This is my website where I showcase some of the things I like.
				The website focuses on digital privacy, technology, and software
				development.
			</p>
			<p>
				I made this webpage to share things I enjoy using, while at the
				same time improving my front-end development skills. It's
				intended to be a hobby project.
			</p>
			<p>
				This webpage is not just about technology. I will also write
				posts about other things I like. Some examples: coffee, running,
				books or just sharing some thoughts about a topic.
			</p>
			<p>
				<a href="/about-this-site" data-astro-prefetch="load"
					>More information on how and why I made this website.</a
				>
			</p>
			<h3>Pages:</h3>
			<ul>
				<li>
					<a href="/blog" data-astro-prefetch
						>Blog posts, reviews, tutorials</a
					>
				</li>
				<li>
					<a href="/books" data-astro-prefetch>
						A list of books I like or want to read
					</a>
				</li>
				<li>
					<a href="/websites" data-astro-prefetch>
						A list of websites, services and software I like
					</a>
				</li>
				<li>
					<a href="/uses" data-astro-prefetch>
						A list of things I use
					</a>
				</li>
				<li>
					<a href="/about" data-astro-prefetch
						>Some information about me</a
					>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
